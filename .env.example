# Optional settings for compose.yaml. Copy to .env next to compose.yaml and uncomment what you need.
# Nothing here is required: secrets and the UI password are created on first start.
# Reference: docs/configuration.md

# --- version and access ---
# TALLYGATE_VERSION=latest                  # image tag, e.g. 0.4 to stay on a minor version
# CONTROL_PUBLISH=0.0.0.0:8080              # host:port for the UI; 127.0.0.1:8080 behind a reverse proxy on this host
# PUBLIC_URL=https://tallygate.example.org  # the UI's URL as users see it (links in notifications)
# COOKIE_SECURE=auto                        # auto: Secure when the browser uses HTTPS; 1 / 0 force it
# TRUST_FORWARDED_FOR=0                     # 1 only behind a reverse proxy, together with TRUSTED_PROXIES
# TRUSTED_PROXIES=                          # IPs/CIDRs of that proxy (see docs/operations.md#reverse-proxy)
# TRUST_PROXY_AUTH_HEADER=                  # e.g. Remote-User; ONLY with TRUSTED_PROXIES
# TRUST_PROXY_SECRET=                       # proxy must send it as X-Tallygate-Proxy-Secret (openssl rand -hex 24)
# FILES_MAX_UPLOAD=52428800                 # Files tab: largest upload into the workspace (bytes)
# FILES_MAX_DOWNLOAD=209715200              # Files tab: largest download (bytes)
# UPDATE_CHECK=1                            # 0: control never asks GitHub whether a newer release exists

# --- state: Docker volumes by default; set host paths to use bind mounts (setup.sh /path does this) ---
# GATEWAY_DATA=/srv/tallygate/gateway       # owned by 10001:10001
# AGENT_HOME=/srv/tallygate/agent-home      # owned by 1000:1000
# WORKSPACE=/srv/tallygate/workspace        # owned by 1000:1000
# CONTROL_DATA=/srv/tallygate/control-data  # owned by 10002:10002 (UI password hash, session secret)

# --- secrets: created automatically; set them here only if you manage secrets yourself ---
# GW_API_TOKEN=
# SESSION_SECRET=
# TTYD_CREDENTIAL=agent:...
# CONTROL_PASSWORD_HASH=                    # python3 control/hashpw.py; replaces the generated password

# --- agent ---
# RC_NAME=tallygate                         # session name in the Claude app
# RC_ENABLE=1
# RC_ARGS=                                  # e.g. --spawn worktree
# AGENT_PERMISSION_MODE=bypassPermissions
# AGENT_MEM_LIMIT=6g
# AGENT_CPUS=0                              # CPU limit of the agent, 0 = none (e.g. 2)
# CLAUDE_VERSION=                           # only when building the image yourself; default: agent/Dockerfile
# AGENT_EXTRA_PACKAGES=                     # only when building the image yourself

# --- notifications (optional) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_ALLOWED_USER_IDS=                # required with Telegram: numeric user ids that may approve
# MATRIX_HOMESERVER=                        # e.g. https://matrix.example.org
# MATRIX_ACCESS_TOKEN=                      # token of a dedicated bot user
# MATRIX_ROOM_ID=                           # !roomid:example.org  (UNENCRYPTED room)
# MATRIX_ALLOWED_USERS=                     # @you:example.org  (comma-separated; never the bot itself)
# Phone notifications without a bot (notify only, decide in the UI or via Web Push):
# NTFY_URL=                                 # topic URL, e.g. https://ntfy.example.org/tallygate
# NTFY_TOKEN=                               # access token (recommended: topic names on public servers are guessable)
# GOTIFY_URL=                               # e.g. https://gotify.example.org
# GOTIFY_TOKEN=                             # application token
# PUSHOVER_TOKEN=                           # application API token
# PUSHOVER_USER=                            # user or group key
# Web Push (installable UI, needs HTTPS) works without settings; optional:
# VAPID_SUBJECT=mailto:you@example.org      # contact for the push services (default: PUBLIC_URL)
# PUSH_ALLOWED_HOSTS=                       # extra push service hosts, e.g. a self-hosted autopush
