# Copy to .env (setup.sh does this and fills the secrets for you).
SLUICEGATE_DIR=/var/docker/sluicegate          # host dir for persistent state (gateway, agent-home, workspace)
CONTROL_PUBLISH=127.0.0.1:8080               # host:port for the UI; put a TLS reverse proxy (+OIDC) in front
PUBLIC_URL=https://sluicegate.example.org     # used in notification links
COOKIE_SECURE=1                              # set 0 only for plain-http testing on localhost
TRUST_FORWARDED_FOR=1                        # 1 when the UI is only reachable through your reverse proxy

# --- generated by setup.sh ---
GW_API_TOKEN=
SESSION_SECRET=
TTYD_CREDENTIAL=
CONTROL_PASSWORD_HASH=                       # python3 control/hashpw.py
# TRUST_PROXY_AUTH_HEADER=Remote-User        # ONLY if a trusted auth proxy sets it and port 8080 is not reachable otherwise

# --- agent ---
RC_NAME=tallygate
RC_ENABLE=1
RC_ARGS=                                     # e.g. --spawn worktree
AGENT_PERMISSION_MODE=bypassPermissions
CLAUDE_VERSION=2.1.304
AGENT_EXTRA_PACKAGES=
AGENT_MEM_LIMIT=6g

# --- notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
MATRIX_HOMESERVER=                           # e.g. https://matrix.example.org
MATRIX_ACCESS_TOKEN=                         # token of a dedicated bot user
MATRIX_ROOM_ID=                              # !roomid:example.org  (UNENCRYPTED room)
MATRIX_ALLOWED_USERS=                        # @you:example.org  (comma-separated; never the bot itself)
