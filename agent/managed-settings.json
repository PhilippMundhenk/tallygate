{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/bin/tallygate-hook",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
